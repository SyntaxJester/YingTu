<?xml version="1.0" encoding="utf-8"?>
<!-- 中央手势反馈组件（移植自 webhtv view_widget_vod.xml） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 快进/快退提示 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/seekWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_widget"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/seekIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_fast_rewind"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/seekTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="00:00:00" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 亮度调节 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/brightWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_widget"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/brightIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_brightness_high"
            app:tint="@android:color/white" />

        <ProgressBar
            android:id="@+id/brightProgress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/progress_widget_white" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 音量调节 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/volumeWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_widget"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/volumeIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_volume_high"
            app:tint="@android:color/white" />

        <ProgressBar
            android:id="@+id/volumeProgress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/progress_widget_white" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 倍速提示 -->
    <ImageView
        android:id="@+id/speedWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_fast_forward"
        android:visibility="gone"
        app:tint="@android:color/white"
        tools:visibility="visible" />

</FrameLayout>
